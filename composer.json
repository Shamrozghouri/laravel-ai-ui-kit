{
    "name": "shamrozghouri/laravel-ui-ai-kit",
    "description": "A drop-in landing page and AI chatbot UI for Laravel applications.",
    "keywords": [
        "laravel",
        "landing-page",
        "chatbot",
        "ai",
        "blade",
        "ui"
    ],
    "homepage": "https://github.com/Shamrozghouri/laravel-ai-ui-kit",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Shamroz Ghouri",
            "email": "158865736+Shamrozghouri@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1 <10.0",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "illuminate/console": ">=10.0 <100.0",
        "illuminate/contracts": ">=10.0 <100.0",
        "illuminate/http": ">=10.0 <100.0",
        "illuminate/routing": ">=10.0 <100.0",
        "illuminate/support": ">=10.0 <100.0",
        "illuminate/view": ">=10.0 <100.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": ">=8.14 <100.0",
        "phpstan/phpstan": "^1.10|^2.0",
        "phpunit/phpunit": "^10.1|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Shamrozghouri\\LaravelUiAiKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shamrozghouri\\LaravelUiAiKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shamrozghouri\\LaravelUiAiKit\\LaravelUiAiKitServiceProvider"
            ]
        }
    }
}
